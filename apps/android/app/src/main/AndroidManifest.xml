<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="OpenPaint"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- Rotation, resizing and display changes reach the activity as surface size changes
             instead of recreating it, so the GPU device and UI state survive them. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The exported picture for the share sheet; readable only with the grant it carries. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="dev.openpaint.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
