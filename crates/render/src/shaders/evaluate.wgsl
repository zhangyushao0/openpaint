// Region evaluation: one workgroup per plan tile, one invocation per pixel. Each pixel runs its
// tile's ops in scene order and stores the composited result. The protocol (TILE, FRESH, OP_*,
// Op, Tile, Params) is generated by protocol.rs and prepended.
//
// A pixel's value depends only on the ops that can reach it, never on which tiles are evaluated
// together; that is what makes incremental evaluation equal cold evaluation. The in-progress
// stroke keeps its coverage (or density) and its paper contact so far in `kept` and
// `kept_contact`, and each evaluation starts from them before adding the new segments in
// order: a maximum is exact, and a sum continued from its stored float adds the same floats in
// the same order as one pass over every segment, so either equals the finished stroke.

@group(0) @binding(0) var<uniform> params: Params;
@group(0) @binding(1) var<storage, read> ops: array<Op>;
@group(0) @binding(2) var<storage, read> tiles: array<Tile>;
@group(0) @binding(3) var<storage, read> indices: array<u32>;
@group(0) @binding(4) var canvas_out: texture_storage_2d<rgba8unorm, write>;
@group(0) @binding(5) var<storage, read> fresh: array<Op>;
@group(0) @binding(6) var kept: texture_storage_2d<r32float, read_write>;
@group(0) @binding(7) var<storage, read> masks: array<u32>;
@group(0) @binding(8) var kept_contact: texture_storage_2d<r32float, read_write>;
@group(0) @binding(9) var<storage, read> paper: array<u32>;
@group(0) @binding(10) var<storage, read> patches: array<u32>;
// The target's finished smudge residuals, and the in-progress smudge's (smudge_composite.wgsl).
@group(0) @binding(11) var<storage, read> arena: array<u32>;
@group(0) @binding(12) var<storage, read> active_residual: array<u32>;

@compute @workgroup_size(TILE, TILE)
fn evaluate(
    @builtin(workgroup_id) group: vec3<u32>,
    @builtin(local_invocation_id) local: vec3<u32>,
) {
    let index = group.y * params.row + group.x;
    if index >= params.tiles {
        return;
    }
    let tile = tiles[index];
    let pixel = tile.origin + local.xy;
    if any(pixel >= params.size) {
        return;
    }
    let centre = vec2<f32>(pixel) + vec2<f32>(0.5);
    // Premultiplied colours throughout; blending happens on sRGB-encoded values.
    var canvas = params.background;
    var layer = vec4<f32>(0.0);
    // The clipping chain so far: its base, and its clipping layers atop it.
    var chain = vec4<f32>(0.0);
    // What lay under the group being composited, kept from its first layer or chain that
    // reached this pixel (`opened`) until its end.
    var backdrop = vec4<f32>(0.0);
    var opened = false;
    // A masked layer's paint, set aside while its mask is painted in `layer` (`OP_BEGIN_MASK`).
    var held = vec4<f32>(0.0);
    // The current stroke's coverage (covering) or optical density (accumulating), and the
    // largest paper contact along it.
    var coverage = 0.0;
    var contact = 0.0;
    // The in-progress stroke's kept values have been taken up.
    var resumed = false;
    for (var i = tile.start; i < tile.start + tile.count; i++) {
        let entry = indices[i];
        var op: Op;
        if entry >= FRESH {
            op = fresh[entry - FRESH];
            if !resumed {
                // Every fresh op is the in-progress stroke's, after its layer's finished
                // strokes, so nothing is held here yet.
                coverage = textureLoad(kept, pixel).r;
                contact = textureLoad(kept_contact, pixel).r;
                resumed = true;
            }
        } else {
            op = ops[entry];
        }
        switch op.code {
            case OP_SEGMENT: {
                if u32(op.data[SEGMENT_TIP]) == TIP_COVER {
                    coverage = max(coverage, segment_coverage(centre, op));
                } else {
                    let laid = segment_density(centre, op);
                    coverage += laid.x;
                    contact = max(contact, laid.y);
                }
            }
            case OP_END_STROKE: {
                layer = blend(stroke_paint(coverage, contact, centre, pixel, op), layer, op);
                coverage = 0.0;
                contact = 0.0;
            }
            case OP_END_ACTIVE: {
                textureStore(kept, pixel, vec4<f32>(coverage, 0.0, 0.0, 0.0));
                textureStore(kept_contact, pixel, vec4<f32>(contact, 0.0, 0.0, 0.0));
                layer = blend(stroke_paint(coverage, contact, centre, pixel, op), layer, op);
                coverage = 0.0;
                contact = 0.0;
            }
            case OP_FILL: {
                layer = blend(paint_color(fill_coverage(pixel, op) * op.data[PAINT_OPACITY], op), layer, op);
            }
            case OP_PATCH: {
                layer = over(patch_sample(centre, op), layer);
            }
            case OP_SMUDGE: {
                layer = smudged(layer, pixel, op);
            }
            case OP_BEGIN_MASK: {
                held = layer;
                layer = vec4<f32>(0.0);
            }
            case OP_END_LAYER: {
                let shown = masked(layer, held, u32(op.data[LAYER_MASK]));
                held = vec4<f32>(0.0);
                let source = shown * op.data[0];
                let mode = u32(op.data[LAYER_MODE]);
                switch u32(op.data[LAYER_INTO]) {
                    case INTO_BASE: {
                        chain = shown;
                    }
                    case INTO_CLIPPED: {
                        chain = clipped(source, chain, mode);
                    }
                    default: {
                        if op.data[LAYER_GROUPED] > 0.0 && !opened {
                            backdrop = canvas;
                            opened = true;
                        }
                        canvas = composite(source, canvas, mode);
                    }
                }
                layer = vec4<f32>(0.0);
            }
            case OP_END_CHAIN: {
                if op.data[LAYER_GROUPED] > 0.0 && !opened {
                    backdrop = canvas;
                    opened = true;
                }
                canvas = composite(chain * op.data[0], canvas, u32(op.data[LAYER_MODE]));
                chain = vec4<f32>(0.0);
            }
            case OP_END_GROUP: {
                // Pass-through: the layers composited onto what lay under the group, then the
                // group's opacity between that and what lay under it (1: exactly the former).
                if opened {
                    canvas = canvas * op.data[0] + backdrop * (1.0 - op.data[0]);
                    opened = false;
                }
            }
            default: {}
        }
    }
    textureStore(canvas_out, pixel, quantized(canvas));
}

// A layer as its end shows it: without a mask `layer` itself; with one, its paint `held` times
// the mask, whose strokes painted grey over transparent in `layer`, read over white
// (`1 - (a - r)`: nothing painted, or white, is exactly 1), inverted for `MASK_INVERTED`. A
// white mask leaves the paint exactly as it was.
fn masked(layer: vec4<f32>, held: vec4<f32>, masking: u32) -> vec4<f32> {
    if masking == MASK_NONE {
        return layer;
    }
    var value = clamp(1.0 - (layer.a - layer.r), 0.0, 1.0);
    if masking == MASK_INVERTED {
        value = 1.0 - value;
    }
    return held * value;
}

// A stroke's colour at its coverage times the grain at `pixel` times its opacity. A covering
// stroke's coverage is `held` itself; an accumulating one's comes from its density
// (`deposit_coverage`). Without grain the factor is exactly 1.
fn stroke_paint(held: f32, contact: f32, centre: vec2<f32>, pixel: vec2<u32>, op: Op) -> vec4<f32> {
    var coverage = held;
    if op.data[PAINT_DENSITY] > 0.0 {
        coverage = deposit_coverage(held, contact, centre, op);
    }
    return paint_color(coverage * grain(pixel, op) * clip(pixel, op) * op.data[PAINT_OPACITY], op);
}

// 1 where a stroke drawn inside a selection may paint (the selection's mask holds `pixel`) or
// where it has no selection, else 0: zero paint, which leaves the layer exactly as it was.
fn clip(pixel: vec2<u32>, op: Op) -> f32 {
    let at = u32(op.data[PAINT_CLIP]) * 65536u + u32(op.data[PAINT_CLIP + 1u]);
    if at == 0u {
        return 1.0;
    }
    return mask_bit(pixel, at - 1u);
}

// The op's colour (`op.data[0..3]`) at `alpha`, premultiplied.
fn paint_color(alpha: f32, op: Op) -> vec4<f32> {
    return vec4<f32>(vec3<f32>(op.data[0], op.data[1], op.data[2]) * alpha, alpha);
}

// 1 where the fill's mask holds `pixel`, else 0: a hard edge.
fn fill_coverage(pixel: vec2<u32>, op: Op) -> f32 {
    return mask_bit(pixel, u32(op.data[FILL_MASK]) * 65536u + u32(op.data[FILL_MASK + 1u]));
}

// 1 where the mask starting at word `at` of `masks` holds `pixel`, else 0. A mask is its
// origin, its size, then rows of whole words, one bit per pixel.
fn mask_bit(pixel: vec2<u32>, at: u32) -> f32 {
    let origin = vec2<u32>(masks[at], masks[at + 1u]);
    let size = vec2<u32>(masks[at + 2u], masks[at + 3u]);
    if any(pixel < origin) || any(pixel >= origin + size) {
        return 0.0;
    }
    let local = pixel - origin;
    let stride = (size.x + 31u) / 32u;
    let word = masks[at + MASK_HEADER + local.y * stride + local.x / 32u];
    return f32((word >> (local.x % 32u)) & 1u);
}

// A transform's patch where the pixel centre maps back to: bilinear between the four nearest
// patch pixels (premultiplied), transparent beyond the patch's edge. A centre that maps onto a
// pixel's centre gets that pixel exactly, so in place nothing changes.
fn patch_sample(centre: vec2<f32>, op: Op) -> vec4<f32> {
    let at = u32(op.data[PATCH_AT]) * 65536u + u32(op.data[PATCH_AT + 1u]);
    let source = vec2<f32>(
        op.data[0] * centre.x + op.data[1] * centre.y + op.data[2],
        op.data[3] * centre.x + op.data[4] * centre.y + op.data[5],
    );
    let origin = vec2<f32>(f32(patches[at]), f32(patches[at + 1u]));
    let local = source - origin - vec2<f32>(0.5);
    let base = floor(local);
    let t = local - base;
    let cell = vec2<i32>(base);
    let top = mix(patch_texel(at, cell), patch_texel(at, cell + vec2<i32>(1, 0)), t.x);
    let bottom = mix(
        patch_texel(at, cell + vec2<i32>(0, 1)),
        patch_texel(at, cell + vec2<i32>(1, 1)),
        t.x,
    );
    return mix(top, bottom, t.y);
}

// The patch's pixel `cell` (from its top-left one), or transparent outside it.
fn patch_texel(at: u32, cell: vec2<i32>) -> vec4<f32> {
    let size = vec2<i32>(i32(patches[at + 2u]), i32(patches[at + 3u]));
    if any(cell < vec2<i32>(0)) || any(cell >= size) {
        return vec4<f32>(0.0);
    }
    return unpack4x8unorm(patches[at + MASK_HEADER + u32(cell.y * size.x + cell.x)]);
}

fn over(source: vec4<f32>, destination: vec4<f32>) -> vec4<f32> {
    return source + destination * (1.0 - source.a);
}

// What source and backdrop (premultiplied) make together where both have paint: the blend
// function times both alphas (W3C compositing, `Sa Da B(Cs, Cb)`), written without dividing by
// an alpha, so it is exactly zero where either has none.
fn mixed(s: vec4<f32>, d: vec4<f32>, mode: u32) -> vec3<f32> {
    switch mode {
        case MODE_MULTIPLY: {
            return s.rgb * d.rgb;
        }
        case MODE_SCREEN: {
            return s.rgb * d.a + d.rgb * s.a - s.rgb * d.rgb;
        }
        case MODE_OVERLAY: {
            let low = 2.0 * s.rgb * d.rgb;
            let high = s.a * d.a - 2.0 * (d.a - d.rgb) * (s.a - s.rgb);
            return select(high, low, 2.0 * d.rgb <= vec3<f32>(d.a));
        }
        default: {
            return s.rgb * d.a;
        }
    }
}

// `source` onto `backdrop` by `mode`: each keeps what the other does not cover, plus what both
// make together; alpha is source over. Normal is `over` itself, so a Normal layer composites
// exactly as before blend modes. Zero source leaves the backdrop exactly as it was.
fn composite(source: vec4<f32>, backdrop: vec4<f32>, mode: u32) -> vec4<f32> {
    if mode == MODE_NORMAL {
        return over(source, backdrop);
    }
    let rgb = source.rgb * (1.0 - backdrop.a) + backdrop.rgb * (1.0 - source.a)
        + mixed(source, backdrop, mode);
    return vec4<f32>(rgb, source.a + backdrop.a * (1.0 - source.a));
}

// A clipping layer's `source` onto its chain: by `mode` against the chain so far, where only
// the chain has paint, its alpha kept (Normal is source atop). Nothing shows where the chain
// has no paint, and zero source leaves the chain exactly as it was.
fn clipped(source: vec4<f32>, chain: vec4<f32>, mode: u32) -> vec4<f32> {
    return vec4<f32>(chain.rgb * (1.0 - source.a) + mixed(source, chain, mode), chain.a);
}

// A stroke's premultiplied paint combined with its layer by the op's blend: over the layer;
// atop it (Alpha Lock: the colour changes only where the layer has alpha, and the alpha stays);
// or erasing (the layer keeps `1 - alpha` of itself). Zero paint leaves the layer exactly as
// it was in every case, as the scene's bounds require.
fn blend(paint: vec4<f32>, layer: vec4<f32>, op: Op) -> vec4<f32> {
    switch u32(op.data[PAINT_BLEND]) {
        case BLEND_ATOP: {
            return paint * layer.a + layer * (1.0 - paint.a);
        }
        case BLEND_ERASE: {
            return layer * (1.0 - paint.a);
        }
        default: {
            return over(paint, layer);
        }
    }
}

// Coverage of a pixel whose centre lies `distance` outside the capsule: it fades in over
// `1 / edge` pixels from half a pixel outside the outline (`edge` 1: box-filtered antialiasing;
// smaller: a soft edge, smoothed), so it is exactly zero from half a pixel out, which the
// scene's bounds rely on. Then times the flow, which changes evenly from `a` to `b`; equal
// flows give that flow exactly.
fn segment_coverage(centre: vec2<f32>, op: Op) -> f32 {
    let a = vec2<f32>(op.data[0], op.data[1]);
    let b = vec2<f32>(op.data[2], op.data[3]);
    let distance = capsule_distance(centre, a, b, op.data[4], op.data[5]);
    let edge = op.data[SEGMENT_EDGE];
    var coverage = clamp((0.5 - distance) * edge, 0.0, 1.0);
    if edge < 1.0 {
        coverage = coverage * coverage * (3.0 - 2.0 * coverage);
    }
    let ab = b - a;
    let h = dot(ab, ab);
    var t = 0.0;
    if h > 0.0 {
        t = clamp(dot(centre - a, ab) / h, 0.0, 1.0);
    }
    let flow_a = op.data[SEGMENT_FLOW];
    let flow_b = op.data[SEGMENT_FLOW + 1u];
    return coverage * (flow_a + (flow_b - flow_a) * t);
}

// The share of paint that lands at `pixel` through the paper's grain, fixed to the canvas: one
// minus the grain strength times the grain's height there. The height is the mean of a fine
// value per pixel and a coarse one, smoothly interpolated between cells of `grain_scale`
// pixels. Integers throughout and a power-of-two divisor at the end: exact on every backend.
fn grain(pixel: vec2<u32>, op: Op) -> f32 {
    let strength = u32(op.data[PAINT_GRAIN]);
    if strength == 0u {
        return 1.0;
    }
    let scale = max(u32(op.data[PAINT_GRAIN_SCALE]), 1u);
    let fine = hash(pixel) >> 24u;
    let cell = pixel / scale;
    let f = pixel % scale;
    let g = scale - f;
    let corners = vec4<u32>(
        hash(cell + vec2<u32>(7919u, 0u)) >> 24u,
        hash(cell + vec2<u32>(7920u, 0u)) >> 24u,
        hash(cell + vec2<u32>(7919u, 1u)) >> 24u,
        hash(cell + vec2<u32>(7920u, 1u)) >> 24u,
    );
    let weighted = corners.x * g.x * g.y + corners.y * f.x * g.y + corners.z * g.x * f.y
        + corners.w * f.x * f.y;
    let coarse = weighted / (scale * scale);
    let height = (fine + coarse) / 2u;
    let reduce = (strength * height) / GRAIN_ONE;
    return f32(GRAIN_ONE - reduce) * GRAIN_STEP;
}

// One step of the grain factor: a power of two, so multiplying by it is exact.
const GRAIN_STEP: f32 = 1.0 / f32(GRAIN_ONE);

// A well-mixed 32-bit value per pixel (PCG).
fn hash(p: vec2<u32>) -> u32 {
    return pcg(p.x ^ pcg(p.y));
}

fn pcg(value: u32) -> u32 {
    let state = value * 747796405u + 2891336453u;
    let word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// Signed distance to the convex hull of the disc at `a` (radius `ra`) and the disc at `b`
// (radius `rb`): a capsule whose radius changes along its length. After Inigo Quilez's uneven
// capsule, rotated into the segment's frame.
fn capsule_distance(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>, ra: f32, rb: f32) -> f32 {
    let ab = b - a;
    let h = dot(ab, ab);
    let dr = ra - rb;
    if h <= dr * dr {
        // One disc holds the other (or both sit on one point): the hull is the larger disc.
        return min(length(p - a) - ra, length(p - b) - rb);
    }
    let ap = p - a;
    // `ap` in units of the segment length: across (mirrored) and along.
    let q = vec2<f32>(abs(dot(ap, vec2<f32>(ab.y, -ab.x))), dot(ap, ab)) / h;
    let c = vec2<f32>(sqrt(h - dr * dr), dr);
    let k = c.x * q.y - c.y * q.x;
    if k < 0.0 {
        return sqrt(h * dot(q, q)) - ra;
    }
    if k > c.x {
        return sqrt(h * (dot(q, q) + 1.0 - 2.0 * q.y)) - rb;
    }
    return dot(c, q) - ra;
}

// Rounds to the 8-bit value `k` here, then stores `(k + 0.25) / 255`, which the unorm write
// turns back into `k` whether the device rounds to nearest or toward zero.
fn quantized(color: vec4<f32>) -> vec4<f32> {
    let k = floor(clamp(color, vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0 + 0.5);
    return min((k + 0.25) / 255.0, vec4<f32>(1.0));
}
