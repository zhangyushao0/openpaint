// Region evaluation: one workgroup per plan tile, one invocation per pixel. Each pixel runs its
// tile's ops in scene order and stores the composited result. The protocol (TILE, FRESH, OP_*,
// Op, Tile, Params) is generated by protocol.rs and prepended.
//
// A pixel's value depends only on the ops that can reach it, never on which tiles are evaluated
// together; that is what makes incremental evaluation equal cold evaluation. The in-progress
// stroke keeps its coverage so far in `kept`: a maximum is exact, so adding only the new
// segments to it equals taking the maximum over all of them.

@group(0) @binding(0) var<uniform> params: Params;
@group(0) @binding(1) var<storage, read> ops: array<Op>;
@group(0) @binding(2) var<storage, read> tiles: array<Tile>;
@group(0) @binding(3) var<storage, read> indices: array<u32>;
@group(0) @binding(4) var canvas_out: texture_storage_2d<rgba8unorm, write>;
@group(0) @binding(5) var<storage, read> fresh: array<Op>;
@group(0) @binding(6) var kept: texture_storage_2d<r32float, read_write>;

@compute @workgroup_size(TILE, TILE)
fn evaluate(
    @builtin(workgroup_id) group: vec3<u32>,
    @builtin(local_invocation_id) local: vec3<u32>,
) {
    let index = group.y * params.row + group.x;
    if index >= params.tiles {
        return;
    }
    let tile = tiles[index];
    let pixel = tile.origin + local.xy;
    if any(pixel >= params.size) {
        return;
    }
    let centre = vec2<f32>(pixel) + vec2<f32>(0.5);
    // Premultiplied colours throughout; blending happens on sRGB-encoded values.
    var canvas = params.background;
    var layer = vec4<f32>(0.0);
    var coverage = 0.0;
    for (var i = tile.start; i < tile.start + tile.count; i++) {
        let entry = indices[i];
        var op: Op;
        if entry >= FRESH {
            op = fresh[entry - FRESH];
        } else {
            op = ops[entry];
        }
        switch op.code {
            case OP_SEGMENT: {
                coverage = max(coverage, segment_coverage(centre, op));
            }
            case OP_END_STROKE: {
                layer = over(stroke_paint(coverage, op), layer);
                coverage = 0.0;
            }
            case OP_END_ACTIVE: {
                coverage = max(coverage, textureLoad(kept, pixel).r);
                textureStore(kept, pixel, vec4<f32>(coverage, 0.0, 0.0, 0.0));
                layer = over(stroke_paint(coverage, op), layer);
                coverage = 0.0;
            }
            case OP_END_LAYER: {
                canvas = over(layer * op.data[0], canvas);
                layer = vec4<f32>(0.0);
            }
            default: {}
        }
    }
    textureStore(canvas_out, pixel, quantized(canvas));
}

// A stroke's colour (`op.data[0..3]`) at `coverage` times its opacity (`op.data[3]`),
// premultiplied.
fn stroke_paint(coverage: f32, op: Op) -> vec4<f32> {
    let alpha = coverage * op.data[3];
    return vec4<f32>(vec3<f32>(op.data[0], op.data[1], op.data[2]) * alpha, alpha);
}

fn over(source: vec4<f32>, destination: vec4<f32>) -> vec4<f32> {
    return source + destination * (1.0 - source.a);
}

// Box-filtered coverage of a pixel whose centre lies `distance` outside the shape: exactly zero
// from half a pixel out, which the scene's bounds rely on.
fn segment_coverage(centre: vec2<f32>, op: Op) -> f32 {
    let a = vec2<f32>(op.data[0], op.data[1]);
    let b = vec2<f32>(op.data[2], op.data[3]);
    let distance = capsule_distance(centre, a, b, op.data[4], op.data[5]);
    return clamp(0.5 - distance, 0.0, 1.0);
}

// Signed distance to the convex hull of the disc at `a` (radius `ra`) and the disc at `b`
// (radius `rb`): a capsule whose radius changes along its length. After Inigo Quilez's uneven
// capsule, rotated into the segment's frame.
fn capsule_distance(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>, ra: f32, rb: f32) -> f32 {
    let ab = b - a;
    let h = dot(ab, ab);
    let dr = ra - rb;
    if h <= dr * dr {
        // One disc holds the other (or both sit on one point): the hull is the larger disc.
        return min(length(p - a) - ra, length(p - b) - rb);
    }
    let ap = p - a;
    // `ap` in units of the segment length: across (mirrored) and along.
    let q = vec2<f32>(abs(dot(ap, vec2<f32>(ab.y, -ab.x))), dot(ap, ab)) / h;
    let c = vec2<f32>(sqrt(h - dr * dr), dr);
    let k = c.x * q.y - c.y * q.x;
    if k < 0.0 {
        return sqrt(h * dot(q, q)) - ra;
    }
    if k > c.x {
        return sqrt(h * (dot(q, q) + 1.0 - 2.0 * q.y)) - rb;
    }
    return dot(c, q) - ra;
}

// Rounds to the 8-bit value `k` here, then stores `(k + 0.25) / 255`, which the unorm write
// turns back into `k` whether the device rounds to nearest or toward zero.
fn quantized(color: vec4<f32>) -> vec4<f32> {
    let k = floor(clamp(color, vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0 + 0.5);
    return min((k + 0.25) / 255.0, vec4<f32>(1.0));
}
